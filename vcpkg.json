{
  "name": "integra-live",
  "version-string": "1.8.2",
  "description": "Dependencies for building Integra Live with vcpkg (used on Windows and for self-contained macOS builds; Linux uses system packages).",
  "dependencies": [
    { "name": "libxml2", "default-features": false, "platform": "windows | osx" },
    { "name": "zlib", "platform": "windows | osx" },
    { "name": "libsndfile", "default-features": false, "platform": "windows | osx" },
    { "name": "fftw3", "platform": "windows | osx" },
    { "name": "portaudio", "platform": "windows | osx" },
    { "name": "portmidi", "platform": "windows | osx" },
    { "name": "gtest", "platform": "windows | osx" },
    { "name": "pthreads", "platform": "windows" }
  ]
}
