<modulecreatorconfig>

	<!--  integradeveloper allows the 'core' tag and the 'implemented in libIntegra' and 'is sent to host'
	      settings (also switched on by the - -developer command line option) -->
	<!-- <integradeveloper/> -->

	<!--  standard tags - offered as defaults when editing tags  -->
	<standardtags>
		<standardtag>simple</standardtag>
		<standardtag>complex</standardtag>
		<standardtag>processing</standardtag>
		<standardtag>synthesis</standardtag>
		<standardtag>analysis</standardtag>
		<standardtag>delay</standardtag>
		<standardtag>filter</standardtag>
		<standardtag>spectral</standardtag>
		<standardtag>granular</standardtag>
		<standardtag>distortion</standardtag>
		<standardtag>dynamics</standardtag>
		<standardtag>resonance</standardtag>
		<standardtag>pitch</standardtag>
		<standardtag>panning</standardtag>
		<standardtag>reverb</standardtag>
		<standardtag>soundfile</standardtag>
		<standardtag>input</standardtag>
		<standardtag>output</standardtag>
	</standardtags>

	<!--  arguments passed to Pd when editing an implementation  -->
	<hostargs>
		<hostarg>-noprefs</hostarg>
	</hostargs>

	<!--  help links: web links, or paths relative to the Module Creator's resources folder  -->
	<helplinks>
		<helplink name="Module Creator Guide">module-creator-guide.md</helplink>
		<helplink name="Pure Data">https://puredata.info</helplink>
		<helplink name="Integra Live (original) Repository">https://github.com/BirminghamConservatoire/IntegraLive</helplink>
	</helplinks>

	<!--  available widgets (the widget types the Integra Live JUCE port can show)  -->
	<widgets>
        <widget name="Checkbox" minWidth="60" minHeight="85" defaultWidth="85" defaultHeight="85" maxWidth="90" maxHeight="120">
            <attribute>value</attribute>
        </widget>
        <widget name="DryWetBalance" minWidth="180" minHeight="180" defaultWidth="180" defaultHeight="180" maxWidth="200" maxHeight="200">
            <attribute>value</attribute>
        </widget>
        <widget name="EarlyLateBalance" minWidth="180" minHeight="180" defaultWidth="180" defaultHeight="180" maxWidth="200" maxHeight="200">
            <attribute>value</attribute>
        </widget>
        <widget name="FileLoadDialog" minWidth="85" minHeight="85" defaultWidth="145" defaultHeight="85" maxWidth="200" maxHeight="85">
            <attribute>value</attribute>
        </widget>
        <widget name="FileSaveDialog" minWidth="85" minHeight="85" defaultWidth="145" defaultHeight="85" maxWidth="200" maxHeight="85">
            <attribute>value</attribute>
        </widget>
        <widget name="Knob" minWidth="60" minHeight="85" defaultWidth="85" defaultHeight="85" maxWidth="90" maxHeight="120">
            <attribute>value</attribute>
        </widget>
        <widget name="LocateFolderDialog" minWidth="85" minHeight="85" defaultWidth="145" defaultHeight="85" maxWidth="200" maxHeight="85">
            <attribute>value</attribute>
        </widget>
        <widget name="NumberBox" minWidth="60" minHeight="85" defaultWidth="85" defaultHeight="85" maxWidth="90" maxHeight="120">
            <attribute>value</attribute>
        </widget>
        <widget name="PanoramaBalance" minWidth="180" minHeight="180" defaultWidth="180" defaultHeight="180" maxWidth="200" maxHeight="200">
            <attribute>value</attribute>
        </widget>
        <widget name="PlayButton" minWidth="60" minHeight="85" defaultWidth="60" defaultHeight="85" maxWidth="90" maxHeight="90">
            <attribute>value</attribute>
        </widget>
        <widget name="RadioGroup" minWidth="85" minHeight="85" defaultWidth="145" defaultHeight="120" maxWidth="180" maxHeight="180">
            <attribute>value</attribute>
        </widget>
        <widget name="RangeSlider" minWidth="60" minHeight="85" defaultWidth="180" defaultHeight="85" maxWidth="200" maxHeight="180">
            <attribute>min</attribute>
            <attribute>max</attribute>
        </widget>
        <widget name="RecButton" minWidth="60" minHeight="85" defaultWidth="60" defaultHeight="85" maxWidth="90" maxHeight="90">
            <attribute>value</attribute>
        </widget>
        <widget name="Slider" minWidth="60" minHeight="85" defaultWidth="60" defaultHeight="180" maxWidth="200" maxHeight="180">
            <attribute>value</attribute>
        </widget>
        <widget name="SoundFileLoadDialog" minWidth="85" minHeight="85" defaultWidth="145" defaultHeight="85" maxWidth="200" maxHeight="85">
            <attribute>value</attribute>
        </widget>
        <widget name="StopButton" minWidth="60" minHeight="85" defaultWidth="60" defaultHeight="85" maxWidth="90" maxHeight="90">
            <attribute>value</attribute>
        </widget>
        <widget name="Trigger" minWidth="60" minHeight="85" defaultWidth="85" defaultHeight="85" maxWidth="90" maxHeight="120">
            <attribute>value</attribute>
        </widget>
        <widget name="VuMeter" minWidth="45" minHeight="45" defaultWidth="60" defaultHeight="180" maxWidth="200" maxHeight="180">
            <attribute>level</attribute>
        </widget>
        <widget name="XYPanPad" minWidth="180" minHeight="180" defaultWidth="180" defaultHeight="180" maxWidth="200" maxHeight="200">
            <attribute>x</attribute>
            <attribute>y</attribute>
        </widget>
        <widget name="XYScratchPad" minWidth="180" minHeight="180" defaultWidth="180" defaultHeight="180" maxWidth="200" maxHeight="200">
            <attribute>x</attribute>
            <attribute>y</attribute>
        </widget>
    </widgets>
</modulecreatorconfig>
